{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["task"],
  "properties": {
    "repository": { "type": "string", "title": "Repository" },
    "task": { "type": "string", "title": "Task", "minLength": 1 },
    "spec": { "type": "string", "title": "Spec or design reference" },
    "focus": { "type": "string", "title": "Review focus" },
    "profile": { "type": "string", "title": "Reviewer profile" },
    "reasoning": { "type": "string", "title": "Reviewer reasoning" },
    "maxRounds": { "type": "integer", "title": "Maximum rounds", "minimum": 1, "maximum": 10 },
    "signalName": { "type": "string", "title": "Review signal name" },
    "stopWhenClean": { "type": "boolean", "title": "Stop when clean" }
  }
}
